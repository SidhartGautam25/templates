      "setupTime": "~10 min",
      "docker": true,
      "tags": [
        "admin",
        "cms",
        "properties",
        "leads"
      ],
      "features": [
        "Admin dashboard for property listings and leads",
        "Dynamic project pages with slug routing",
        "FTP asset upload pipeline",
        "LeadRat CRM integration",
        "Docker Compose for local MariaDB"
      ],
      "docs": "GETTING_STARTED.md",
      "init": {
        "flagGroups": [
          "generate",
          "theme",
          "brand",
          "database"
        ],
        "brandFields": [
          "name",
          "shortName",
