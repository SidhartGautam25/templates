          "phoneDisplay",
          "countryCode",
          "email",
          "address",
          "tagline",
          "developerName",
          "channelPartner",
          "agentRera"
        ]
      },
      "coreModules": [
        "enquiry-modal",
        "footer",
        "hero-simple",
        "seo"
      ],
      "templateModules": [
        "projects",
        "slug-pages"
      ]
    },
    "dev-agency": {
      "directory": "dev-agency-website-template",
      "name": "Dev Agency Website",
      "description": "Freelance dev agency landing page — expertise, team, CTA, featured work carousel, leads, and SEO",
      "version": "1.0.0",
      "stack": [
        "Next.js 16",
        "React 19",
        "TypeScript",
        "Tailwind CSS 4",
        "Prisma",
        "MariaDB",
