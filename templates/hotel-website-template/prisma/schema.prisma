datasource db {
  provider = "mysql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model Lead {
  id          String   @id @default(uuid())
  projectName String
  name        String
  email       String
  phone       String
  message     String?
  createdAt   DateTime @default(now())
}

model PromoBanner {
  id               String   @id @default("global")
  imageUrl         String   @db.Text
  sec1Title        String
  sec1Sub          String
  sec2Title        String
  sec2Sub          String
  sec3Title        String
  sec3Sub          String
  sec4Title        String
  sec4Sub          String
  newLaunchLogoUrl String?  @db.Text
  updatedAt        DateTime @updatedAt
}

model RoomType {
  id            String   @id @default(uuid())
  name          String   @unique
  startingPrice Int
  size          String
  view          String
  bedType       String
  bathrooms     String
  amenities     Json
  ratePlans     Json
  image         String   @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HotelConfig {
  id             String   @id @default("global")
  address        String   @db.Text
  templeDistance String   @db.Text
  phone          String?
  email          String?
  updatedAt      DateTime @updatedAt
}

model Facility {
  id          String   @id @default(uuid())
  title       String   @unique
  description String   @db.Text
  icon        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(uuid())
  name        String
  otherInfo   String?
  description String   @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
