model RoomType {
  id            String   @id @default(uuid())
  name          String   @unique
  startingPrice Int
  size          String
  view          String
  bedType       String
  bathrooms     String
  amenities     Json
  ratePlans     Json
  image         String   @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HotelConfig {
  id             String   @id @default("global")
  address        String   @db.Text
  templeDistance String   @db.Text
  phone          String?
  email          String?
  updatedAt      DateTime @updatedAt
}

model Facility {
  id          String   @id @default(uuid())
  title       String   @unique
  description String   @db.Text
  icon        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(uuid())
  name        String
  otherInfo   String?
  description String   @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("general")
  description String?  @db.Text
  imageUrl    String   @db.Text
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
