model RoomType {
  id            String   @id @default(uuid())
  name          String   @unique
  startingPrice Int
  size          String
  view          String
  bedType       String
  bathrooms     String
  amenities     Json
  ratePlans     Json
  image         String   @db.Text
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
