# =============================================================================
# REQUIRED — app will not start without these
# =============================================================================

# MySQL/MariaDB connection string for Prisma
# Local Docker example (after docker compose up -d):
# DATABASE_URL="mysql://root:password@localhost:3306/app_db"
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/YOUR_DB_NAME"

# Auth.js secret — generate with: openssl rand -base64 33
AUTH_SECRET="your_next_auth_secret_here"

# Admin dashboard login (/admin)
ADMIN_USER="admin"
ADMIN_PASSWORD="change_this_password"
AUTH_TRUST_HOST=true

# =============================================================================
# OPTIONAL — features are disabled when unset
# =============================================================================

# FTP asset uploads (admin image uploads go to local public/ if empty)
FTP_HOST=""
FTP_USER=""
FTP_PASSWORD=""
FTP_PORT=21
FTP_REMOTE_PATH="public/assets"
