datasource db {
  provider = "mysql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

model Lead {
  id          String   @id @default(uuid())
  projectName String
  name        String
  email       String
  phone       String
  message     String?
  createdAt   DateTime @default(now())
}

model PromoBanner {
  id               String   @id @default("global")
  imageUrl         String   @db.Text
  sec1Title        String
  sec1Sub          String
  sec2Title        String
  sec2Sub          String
  sec3Title        String
  sec3Sub          String
  sec4Title        String
  sec4Sub          String
  newLaunchLogoUrl String?  @db.Text
  updatedAt        DateTime @updatedAt
}
