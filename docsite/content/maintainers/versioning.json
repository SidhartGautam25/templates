{
  "title": "Versioning",
  "description": "CLI and template release tracking with git baselines.",
  "blocks": [
    {
      "type": "paragraph",
      "text": ".tempjs-version.json records the git commit at each bump. tempjs version check diffs watched paths since that commit."
    },
    {
      "type": "command-builder",
      "builderId": "maintainer-version-inc"
    },
    {
      "type": "command-ref",
      "id": "version-check"
    },
    {
      "type": "command-ref",
      "id": "version-inc"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "What is watched"
    },
    {
      "type": "table",
      "headers": ["Scope", "Paths"],
      "rows": [
        ["CLI", "cli/, package.json, templates.json"],
        ["Template hotel", "templates/hotel-website-template/"],
        ["Core change", "packages/core/ — bump templates if you shipped a shared fix"]
      ]
    },
    {
      "type": "callout",
      "variant": "tip",
      "title": "CHANGELOG location",
      "text": "Edit templates/<directory>/CHANGELOG.md in the template folder."
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Semver guide"
    },
    {
      "type": "table",
      "headers": ["Level", "CLI example", "Template example"],
      "rows": [
        ["patch", "Bugfix, docs", "Copy fix, seed tweak"],
        ["minor", "New command (doctor)", "New page, non-breaking API"],
        ["major", "Breaking CLI flags", "Breaking schema or removed files"]
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Release checklist"
    },
    {
      "type": "list",
      "items": [
        "Edit templates/<directory>/CHANGELOG.md",
        "If you changed packages/core: pnpm sync-templates (optional propagate)",
        "tempjs version check",
        "tempjs version inc minor hotel (or patch cli)",
        "git commit; npm publish for CLI when needed"
      ]
    }
  ]
}
